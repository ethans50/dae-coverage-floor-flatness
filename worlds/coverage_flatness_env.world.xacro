<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 건물 모델명은 params.yaml의 environment_modeling.dae_file에서 확장자를 뗀 값임.
       sim_env.launch.py가 그 값을 넘겨 실행 시점에 실제 world를 만듦 - 맵과 시뮬
       건물이 서로 다른 모델을 가리키는 것을 막기 위해 출처를 params.yaml 하나로 둠. -->
  <xacro:arg name="model_name" default="INU_9_211"/>
  <world name="default">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
    
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>20.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.00100</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="$(arg model_name)">
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://$(arg model_name)</uri>
      </include>
    </model>

  </world>
</sdf>
